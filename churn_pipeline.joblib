   "source": [
    "# Proxy grouping based on churn label\n",
    "df[\"Sentiment_Label\"] = df[\"Churn\"].map({1: \"Negative\", 0: \"Positive\"})"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 25,
   "id": "2df36300-f1a7-41eb-bea6-b8517410eb55",
